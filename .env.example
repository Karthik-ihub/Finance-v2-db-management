# Supabase Database Connection
# Use the direct connection string from your Supabase project settings
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Or use the pooler: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

DATABASE_URL=postgresql://postgres.ialtahptjcebrgdkuytl:Pathuthangam%402004@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?

# Database schema to backup
SCHEMA=public

# Backup Configuration
# Comma-separated list of specific tables to backup (leave empty for ALL tables)
ONLY_TABLES=

# Comma-separated list of tables to skip
SKIP_TABLES=_prisma_migrations

# Maximum number of retry attempts for failed tables
MAX_RETRIES=3

# Delay in seconds between retry attempts
RETRY_DELAY_SECONDS=2

# Batch size for large tables (0 or empty for no batching)
BATCH_SIZE=
