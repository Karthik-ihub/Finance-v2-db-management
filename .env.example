# =============================================================================
# DATABASE BACKUP & MIGRATION CONFIGURATION
# =============================================================================
#
# IMPORTANT SAFETY NOTES:
# - NEVER include passwords in database URLs
# - Use PGPASSWORD or PGPASSFILE for authentication
# - Validation restores MUST use a dedicated validation database
# - Validation database identity MUST be explicitly configured
# - Archive readability does NOT prove restore success
#
# =============================================================================

# =============================================================================
# SOURCE DATABASE (for backup.py)
# =============================================================================
# Connection URL for the source database to back up.
# MUST be password-free. Use PGPASSWORD or PGPASSFILE for authentication.
#
# Examples:
#   Direct connection:
#   SOURCE_DATABASE_URL=postgresql://postgres@db.[PROJECT-REF].supabase.co:5432/postgres
#   Session Pooler connection:
#   SOURCE_DATABASE_URL=postgresql://postgres.[PROJECT-REF]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Alias: DATABASE_URL can also be used (backup.py uses SOURCE_DATABASE_URL first, then DATABASE_URL)
SOURCE_DATABASE_URL=postgresql://postgres@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres@db.[PROJECT-REF].supabase.co:5432/postgres

# PostgreSQL authentication (NEVER in URL)
# Set ONE of these, not both:
PGPASSWORD=
PGPASSFILE=

# =============================================================================
# TARGET DATABASE CONFIGURATION (for migrate.py)
# =============================================================================
#
# There are TWO target modes:
# 1. validation - For validation restores (default, recommended)
# 2. approved-target - For production restores (requires --allow-production)
#
# TARGET_DATABASE_URL: Connection URL for the target database.
#   MUST be password-free. Use PGPASSWORD or PGPASSFILE.
#
TARGET_DATABASE_URL=postgresql://postgres@db.[TARGET-PROJECT-REF].supabase.co:5432/postgres

# TARGET_DATABASE_MODE: Either "validation" or "approved-target"
# Default: validation (safe, requires explicit identity match)
TARGET_DATABASE_MODE=validation

# =============================================================================
# VALIDATION DATABASE CONFIGURATION (for restore_validation.py)
# =============================================================================
#
# Validation restores MUST use a dedicated validation database.
# The validation database identity MUST be explicitly configured below.
#
# These settings are REQUIRED for validation restores to run.
# The target URL must match these settings exactly.
#
# Validation database connection URL (password-free):
VALIDATION_DATABASE_URL=postgresql://postgres@db.[VALIDATION-PROJECT-REF].supabase.co:5432/supabase_restore_validation

# Explicit validation database identity (REQUIRED):
# These settings are used to verify the target is the correct validation database.
# The restore_validation.py script will REJECT any target that doesn't match.
VALIDATION_DATABASE_HOST=db.[VALIDATION-PROJECT-REF].supabase.co
VALIDATION_DATABASE_NAME=supabase_restore_validation
VALIDATION_PROJECT_REF=[VALIDATION-PROJECT-REF]

# =============================================================================
# BACKUP SETTINGS
# =============================================================================

# The schema setting is kept for optional CSV export compatibility.
# For a complete database backup, leave SCHEMA as "public" or your main schema.
SCHEMA=public

# Comma-separated specific tables for supplementary CSV export only.
# Leave blank for all tables in the schema.
ONLY_TABLES=

# Comma-separated tables to skip for supplementary CSV export only.
# Leave blank for a full CSV export of selected schema.
SKIP_TABLES=

# Optional CSV backup control.
# Set to true when you want a supplementary CSV export in addition to the pg_dump archive.
# DEFAULT: false (CSV is optional, pg_dump archive is primary)
EXPORT_CSV=false

# Optional subset of schemas to dump with pg_dump.
# Leave blank to dump ALL accessible schemas (RECOMMENDED for complete migration backup).
# WARNING: Setting this creates a PARTIAL backup. An explicit reviewed schema scope
# is REQUIRED before treating a migration backup as ready for migration.
DUMP_SCHEMAS=

# Retry settings for transient PostgreSQL connection failures
MAX_RETRIES=3
RETRY_DELAY_SECONDS=2

# =============================================================================
# OUTPUT SETTINGS
# =============================================================================
# Backup directory prefix. Timestamp will be appended.
BACKUP_DIR_PREFIX=supabase_backup

# =============================================================================
# POSTGRESQL CLI TOOL PATHS
# =============================================================================
# Leave blank to use system PATH.
# Set these if pg_dump/pg_restore are not on PATH.
PG_DUMP_PATH=
PG_RESTORE_PATH=

# =============================================================================
# RESTORE SETTINGS (for migrate.py)
# =============================================================================
# Number of parallel jobs for restore
RESTORE_JOBS=4

# =============================================================================
# DEPRECATED / UNUSED SETTINGS
# =============================================================================
# These settings are NOT used by the current scripts and are kept for reference.
# They may be removed in future versions.
#
# TARGET_SCHEMA - Not used; schemas are determined from the archive
# FORCE_OVERWRITE - Not used; overwrites are NEVER automatic
# CREATE_TABLES - Not used; pg_restore handles table creation

# DO NOT USE these settings:
# TARGET_SCHEMA=
# FORCE_OVERWRITE=
# CREATE_TABLES=

# =============================================================================
# PGPASSWORD / PGPASSFILE INSTRUCTIONS
# =============================================================================
#
# NEVER put passwords in database URLs. Instead, use:
#
# Option 1: PGPASSWORD environment variable
#   Set in your shell:
#   $env:PGPASSWORD = "your-secret-password"
#
# Option 2: .pgpass file (RECOMMENDED for security)
#   Create a file at: C:\Users\[YOUR-USER]\.pgpass (Windows) or ~/.pgpass (Linux/Mac)
#   Format: hostname:port:database:username:password
#   Set permissions to 600 (read/write only by owner)
#   Then set: PGPASSFILE=C:\path\to\.pgpass
#
# Example .pgpass entry:
#   db.[PROJECT-REF].supabase.co:5432:postgres:postgres:your-secret-password
#
# The scripts will use PGPASSWORD or PGPASSFILE automatically.
# Database URLs should ALWAYS be password-free.
